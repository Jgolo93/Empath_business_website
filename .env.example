# Copy this file to .env for local development (never commit .env).
# In production (Vercel), set these under Project Settings -> Environment Variables instead.

# Flask
FLASK_SECRET_KEY=

# Database (Neon Postgres)
DATABASE_URL=

# Zoho Mail (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Zoho OAuth (used by /oauth/callback)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_OAUTH_REDIRECT_URI=https://www.empathtechnologysolutions.com/oauth/callback

# Internal API auth
ZOHO_DESK_WEBHOOK_SECRET=
ADMIN_API_SECRET=

# Shopify Storefront API (powers /shop)
# Install the "Headless" sales channel (Shopify App Store) -> Sales channels -> Headless
# -> Create storefront -> edit Storefront API permissions (unauthenticated_read_product_listings,
# unauthenticated_read_product_inventory, unauthenticated_read_product_tags,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts) -> copy the PRIVATE access
# token (server-side use only, never send it to the browser).
# Note: the old "Develop apps -> API Credentials" token flow is deprecated as of 2026.
SHOPIFY_STORE_DOMAIN=shop.empathtechnologysolutions.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10

# SMSPortal (back-in-stock and other transactional SMS)
SMS_PORTAL_CLIENT_ID=
SMS_PORTAL_CLIENT_SECRET=
