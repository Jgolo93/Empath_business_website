# Copy this file to .env for local development (never commit .env).
# In production (Vercel), set these under Project Settings -> Environment Variables instead.

# Flask
FLASK_SECRET_KEY=

# Database (Neon Postgres)
DATABASE_URL=

# Zoho Mail (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Zoho OAuth (used by /oauth/callback)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_OAUTH_REDIRECT_URI=https://www.empathtechnologysolutions.com/oauth/callback

# Internal API auth
ZOHO_DESK_WEBHOOK_SECRET=
ADMIN_API_SECRET=

# SMSPortal (transactional SMS, e.g. referral status updates)
SMS_PORTAL_CLIENT_ID=
SMS_PORTAL_CLIENT_SECRET=
